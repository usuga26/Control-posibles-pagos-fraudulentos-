{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Iniciar Servidor (Velum)",
            "type": "shell",
            "command": "uvicorn",
            "args": [
                "app.main:app",
                "--reload"
            ],
            "options": {
                "cwd": "${workspaceFolder}/Velum"
            },
            "runOptions": {
                "runOn": "folderOpen"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "isBackground": true,
            "problemMatcher": []
        }
    ]
}
